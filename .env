TAVILY_API_KEY=paste_your_tavily_api_key_here

   # LLM keys. The app tries Groq first, then Gemini, then Llama.
   # Providers left as paste_your_... are skipped.
   GROQ_API_KEY=paste_your_groq_api_key_here
   GEMINI_API_KEY=paste_your_gemini_api_key_here
   LLAMA_API_KEY=paste_your_llama_api_key_here
   LLAMA_BASE_URL=paste_your_llama_base_url_here
   LLAMA_MODEL=paste_your_llama_model_name_here

   # Optional, model names change over time
   # GROQ_MODEL=llama-3.3-70b-versatile
   # GEMINI_MODEL=gemini-3.8-flash
